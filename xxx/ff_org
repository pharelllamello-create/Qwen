"""
Pharell AI - Application principale
Réunit : chat / génération de code / génération de script / génération d'images /
recherche web / analyse de fichiers / génération + déploiement d'apps / upload YouTube.

Lancement : python app.py
"""
import os
import uuid
import gradio as gr

from modules import llm, image_gen, web_search, file_analysis, memory, app_generator

try:
    from modules import youtube_upload
    YOUTUBE_AVAILABLE = True
except ImportError:
    YOUTUBE_AVAILABLE = False

try:
    from modules import deploy_vercel
    DEPLOY_AVAILABLE = True
except ImportError:
    DEPLOY_AVAILABLE = False


PHARELL_SYSTEM_PROMPT = (
    "Tu es Pharell AI, un assistant intelligent, polyvalent et bienveillant. "
    "Tu réponds en français par défaut, de manière claire et utile. "
    "Tu peux écrire du code, expliquer des concepts, et aider sur des tâches variées."
)

CUSTOM_CSS = """
#chatbot { background: rgba(20, 10, 40, 0.55); border-radius: 18px; border: 1px solid #a259ff55; }
.gradio-container { font-family: 'Poppins', 'Segoe UI', sans-serif; }
h1, h2, h3 { background: linear-gradient(90deg, #ff6ec7, #7b2ff7, #58c7ff);
             -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
footer { visibility: hidden; }
"""

pharell_theme = gr.themes.Soft(
    primary_hue=gr.themes.colors.purple,
    secondary_hue=gr.themes.colors.pink,
)

SESSION_ID = str(uuid.uuid4())[:8]


# ---------------------------------------------------------------------------
# Onglet 1 : Chat (avec option "recherche web" et fichier joint)
# ---------------------------------------------------------------------------
def chat_fn(message, history, use_web_search, attached_file):
    context = ""

    if use_web_search:
        try:
            results = web_search.web_search(message, num_results=5)
            context += "\n\nRésultats de recherche web:\n" + "\n".join(
                f"- {r['title']}: {r['snippet']} ({r['link']})" for r in results
            )
        except Exception as e:
            context += f"\n\n[Recherche web indisponible: {e}]"

    if attached_file is not None:
        try:
            file_content = file_analysis.analyze_file(attached_file.name)
            context += f"\n\nContenu du fichier joint:\n{file_content}"
        except Exception as e:
            context += f"\n\n[Impossible d'analyser le fichier: {e}]"

    messages = []
    for user_msg, bot_msg in history:
        messages.append({"role": "user", "content": user_msg})
        if bot_msg:
            messages.append({"role": "assistant", "content": bot_msg})
    messages.append({"role": "user", "content": message + context})

    try:
        response = llm.chat(messages, system_prompt=PHARELL_SYSTEM_PROMPT)
    except Exception as e:
        response = f"⚠️ Erreur : {e}"

    history.append((message, response))
    memory.save_session(SESSION_ID, history)
    return "", history


def clear_chat():
    return []


# ---------------------------------------------------------------------------
# Onglet 2 : Génération de code / scripts
# ---------------------------------------------------------------------------
def code_fn(instruction, language):
    try:
        return llm.generate_code(instruction, language=language)
    except Exception as e:
        return f"⚠️ Erreur : {e}"


def script_fn(task_description, target):
    try:
        return llm.generate_script(task_description, target=target)
    except Exception as e:
        return f"⚠️ Erreur : {e}"


# ---------------------------------------------------------------------------
# Onglet 3 : Génération d'images
# ---------------------------------------------------------------------------
def image_fn(prompt, size):
    try:
        paths = image_gen.generate_image(prompt, size=size)
        return paths
    except Exception as e:
        return None, f"⚠️ Erreur : {e}"


# ---------------------------------------------------------------------------
# Onglet 4 : Génération + déploiement d'applications
# ---------------------------------------------------------------------------
def webapp_fn(description, deploy):
    try:
        if deploy and DEPLOY_AVAILABLE:
            url, code = app_generator.generate_and_deploy_webapp(description)
            return code, f"✅ Déployé : {url}"
        else:
            code = app_generator.generate_webapp(description)
            return code, "ℹ️ Génération seule (déploiement désactivé ou indisponible)."
    except Exception as e:
        return "", f"⚠️ Erreur : {e}"


# ---------------------------------------------------------------------------
# Onglet 5 : Upload YouTube
# ---------------------------------------------------------------------------
def youtube_fn(video_file, title, description, privacy):
    if not YOUTUBE_AVAILABLE:
        return "⚠️ Dépendances YouTube non installées (google-api-python-client)."
    try:
        url = youtube_upload.upload_video(video_file.name, title, description, privacy_status=privacy)
        return f"✅ Vidéo uploadée : {url}"
    except Exception as e:
        return f"⚠️ Erreur : {e}"


# ---------------------------------------------------------------------------
# Interface
# ---------------------------------------------------------------------------
with gr.Blocks(theme=pharell_theme, css=CUSTOM_CSS, title="Pharell AI") as demo:
    gr.Markdown("<center><font size=8>🌈 Pharell AI 🌈</center>")
    gr.Markdown("<center>Assistant IA complet : chat, code, images, recherche web, apps et publication.</center>")

    with gr.Tab("💬 Chat"):
        chatbot = gr.Chatbot(elem_id="chatbot", height=450)
        with gr.Row():
            msg = gr.Textbox(label="Message", scale=4)
            web_toggle = gr.Checkbox(label="🔎 Recherche web", value=False, scale=1)
        file_input = gr.File(label="📎 Joindre un fichier (PDF, DOCX, XLSX, CSV, TXT...)")
        with gr.Row():
            send_btn = gr.Button("🚀 Envoyer", variant="primary")
            clear_btn = gr.Button("🧹 Effacer")

        send_btn.click(chat_fn, [msg, chatbot, web_toggle, file_input], [msg, chatbot])
        msg.submit(chat_fn, [msg, chatbot, web_toggle, file_input], [msg, chatbot])
        clear_btn.click(clear_chat, outputs=chatbot)

    with gr.Tab("💻 Code"):
        gr.Markdown("### Génération de code")
        code_instruction = gr.Textbox(label="Décris ce que le code doit faire", lines=3)
        code_lang = gr.Dropdown(["python", "javascript", "html", "css", "java", "c++", "sql"], value="python", label="Langage")
        code_output = gr.Code(label="Code généré", language="python")
        gr.Button("⚡ Générer le code", variant="primary").click(code_fn, [code_instruction, code_lang], code_output)

        gr.Markdown("### Génération de script d'automatisation")
        script_task = gr.Textbox(label="Décris la tâche à automatiser", lines=3)
        script_target = gr.Dropdown(["python", "bash", "javascript"], value="python", label="Cible")
        script_output = gr.Code(label="Script généré")
        gr.Button("⚙️ Générer le script", variant="primary").click(script_fn, [script_task, script_target], script_output)

    with gr.Tab("🎨 Images"):
        img_prompt = gr.Textbox(label="Décris l'image à générer", lines=2)
        img_size = gr.Dropdown(["1024x1024", "1792x1024", "1024x1792"], value="1024x1024", label="Format")
        img_gallery = gr.Gallery(label="Résultat")
        gr.Button("🎨 Générer l'image", variant="primary").click(image_fn, [img_prompt, img_size], img_gallery)

    with gr.Tab("🌐 Applications"):
        app_desc = gr.Textbox(label="Décris l'application web à créer", lines=3,
                               placeholder="Ex: une todo-list avec ajout, suppression et sauvegarde locale")
        app_deploy_toggle = gr.Checkbox(label="Déployer automatiquement (Vercel)", value=False)
        app_code_output = gr.Code(label="Code de l'application", language="html")
        app_status = gr.Textbox(label="Statut")
        gr.Button("🚀 Générer l'application", variant="primary").click(
            webapp_fn, [app_desc, app_deploy_toggle], [app_code_output, app_status]
        )

    with gr.Tab("📺 YouTube"):
        gr.Markdown("Upload direct via l'API officielle YouTube (OAuth requis au premier lancement).")
        yt_file = gr.File(label="Fichier vidéo (.mp4)")
        yt_title = gr.Textbox(label="Titre")
        yt_desc = gr.Textbox(label="Description", lines=3)
        yt_privacy = gr.Dropdown(["private", "unlisted", "public"], value="private", label="Confidentialité")
        yt_status = gr.Textbox(label="Statut")
        gr.Button("📤 Uploader sur YouTube", variant="primary").click(
            youtube_fn, [yt_file, yt_title, yt_desc, yt_privacy], yt_status
        )

    gr.Markdown(
        "<font size=2>⚠️ Pharell AI nécessite tes propres clés API (LLM, images, YouTube, Vercel) "
        "définies en variables d'environnement — voir README.md.</font>"
    )

if __name__ == "__main__":
    demo.queue().launch(server_name="0.0.0.0", server_port=8000)
